{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rizbot4u/nova-spec/main/skill-contract.schema.json",
  "title": "NOVA Skill Contract",
  "description": "Machine-checkable manifest for every registered NOVA skill. Enforces all 8 invariants in SKILL_CONTRACT.md.",
  "type": "object",
  "required": [
    "identity",
    "ownership",
    "input",
    "output",
    "authorization",
    "risk",
    "approval",
    "execution",
    "impact",
    "retry",
    "audit",
    "evaluation"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/rizbot4u/nova-spec/main/skill-contract.schema.json"
    },

    "identity": {
      "type": "object",
      "required": ["skill_id", "name", "version", "status"],
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
          "description": "Namespaced, stable, e.g. market.ticker or trading.order.spot"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$",
          "description": "SemVer. Immutable once published."
        },
        "status": { "enum": ["draft", "active", "deprecated", "disabled"] }
      }
    },

    "ownership": {
      "type": "object",
      "required": ["owner_type", "owner_id"],
      "additionalProperties": false,
      "properties": {
        "owner_type": { "enum": ["platform", "tenant", "organization", "actor"] },
        "owner_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "owner_type": { "const": "tenant" } } },
          "then": { "required": ["tenant_id"] }
        }
      ]
    },

    "input": {
      "$ref": "#/$defs/closed_schema"
    },
    "output": {
      "$ref": "#/$defs/closed_schema"
    },

    "authorization": {
      "type": "object",
      "required": ["permissions"],
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,4}$"
          }
        },
        "policy_ref": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },

    "risk": {
      "type": "object",
      "required": ["level", "policy_ref", "limits"],
      "additionalProperties": false,
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "policy_ref": { "type": "string", "minLength": 1, "maxLength": 128 },
        "limits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "unit"],
            "additionalProperties": false,
            "properties": {
              "name":  { "type": "string", "minLength": 1, "maxLength": 64 },
              "value": { "type": "number" },
              "unit":  { "type": "string", "minLength": 1, "maxLength": 32 }
            }
          }
        }
      }
    },

    "approval": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["none", "conditional", "always"] },
        "policy_ref": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["conditional", "always"] } } },
          "then": { "required": ["policy_ref"] }
        }
      ]
    },

    "execution": {
      "type": "object",
      "required": ["rails", "provider", "operation", "side_effect", "idempotency"],
      "additionalProperties": false,
      "properties": {
        "rails": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cex", "dex"] }
        },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 64 },
        "side_effect": { "enum": ["read", "write"] },
        "idempotency": { "enum": ["not_applicable", "required"] }
      },
      "allOf": [
        {
          "if": { "properties": { "side_effect": { "const": "write" } } },
          "then": { "properties": { "idempotency": { "const": "required" } } }
        }
      ]
    },

    "impact": {
      "type": "object",
      "required": ["class"],
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": ["read", "stateful_read", "write", "financial", "destructive"]
        },
        "materiality": { "enum": ["none", "low", "medium", "high"] }
      }
    },

    "retry": {
      "type": "object",
      "required": ["max_attempts", "retry_on", "backoff"],
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "retry_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["timeout", "rate_limit", "transient_provider"] }
        },
        "backoff": {
          "type": "object",
          "required": ["initial_ms", "max_ms", "multiplier"],
          "additionalProperties": false,
          "properties": {
            "initial_ms": { "type": "integer", "minimum": 50,  "maximum": 10000 },
            "max_ms":     { "type": "integer", "minimum": 100, "maximum": 60000 },
            "multiplier": { "type": "number", "exclusiveMinimum": 1, "maximum": 5 }
          }
        }
      }
    },

    "audit": {
      "type": "object",
      "required": ["include_standard_fields", "additional_fields"],
      "additionalProperties": false,
      "properties": {
        "include_standard_fields": { "const": true },
        "additional_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },

    "evaluation": {
      "type": "object",
      "required": ["routing", "parameters", "security", "execution"],
      "additionalProperties": false,
      "properties": {
        "routing":    { "$ref": "#/$defs/non_empty_str_list" },
        "parameters": { "$ref": "#/$defs/non_empty_str_list" },
        "security":   { "$ref": "#/$defs/non_empty_str_list" },
        "execution":  { "$ref": "#/$defs/non_empty_str_list" }
      }
    }
  },

  "$defs": {
    "non_empty_str_list": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },

    "closed_schema": {
      "type": "object",
      "required": ["schema"],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "object",
          "required": ["$schema", "type", "additionalProperties"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "type": { "const": "object" },
            "additionalProperties": { "const": false }
          },
          "description": "The inner schema must declare the 2020-12 draft, type: object, and additionalProperties: false. Registry validator additionally rejects any non-local $ref."
        }
      }
    }
  },

  "allOf": [
    {
      "$comment": "Gap #1 closure: write/financial/destructive impacts require approval.",
      "if": {
        "properties": {
          "impact": {
            "properties": {
              "class": { "enum": ["write", "financial", "destructive"] }
            },
            "required": ["class"]
          }
        },
        "required": ["impact"]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "mode": { "enum": ["conditional", "always"] }
            },
            "required": ["mode"]
          }
        },
        "required": ["approval"]
      }
    },
    {
      "$comment": "Gap #1 (dual): write side_effect requires approval too.",
      "if": {
        "properties": {
          "execution": {
            "properties": { "side_effect": { "const": "write" } },
            "required": ["side_effect"]
          }
        },
        "required": ["execution"]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "mode": { "enum": ["conditional", "always"] }
            },
            "required": ["mode"]
          }
        },
        "required": ["approval"]
      }
    }
  ]
}
